{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tv-ads-close device profile (schema v2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "brand",
    "model",
    "device",
    "android",
    "sdk",
    "firmware",
    "status",
    "settings",
    "disable",
    "never_disable"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "brand": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "device": { "type": "string", "minLength": 1 },
    "android": { "type": "integer", "minimum": 5 },
    "sdk": { "type": "integer", "minimum": 21 },
    "firmware": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "not": { "const": "*" } }
    },
    "status": { "enum": ["draft", "observed", "verified"] },
    "observed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "tested_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": { "type": "string" },
    "setup": { "type": "array", "items": { "type": "string" } },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "global": { "$ref": "#/definitions/settingMap" },
        "system": { "$ref": "#/definitions/settingMap" },
        "secure": { "$ref": "#/definitions/settingMap" }
      }
    },
    "disable": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "reason", "risk", "evidence"],
        "properties": {
          "package": { "type": "string", "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)+$" },
          "reason": { "type": "string", "minLength": 1 },
          "risk": { "enum": ["low", "medium"] },
          "opt_in": { "type": "boolean" },
          "evidence": { "$ref": "#/definitions/evidence" }
        }
      }
    },
    "never_disable": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)+$" }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "deprecated": { "type": "boolean" }
  },
  "definitions": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "method", "date"],
      "properties": {
        "level": { "enum": ["E0", "E1", "E2", "E3"] },
        "method": { "type": "string", "minLength": 1 },
        "before": { "type": "string" },
        "after": { "type": "string" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reviewer": { "type": "string" }
      }
    },
    "settingMap": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "reason", "risk", "evidence"],
        "properties": {
          "value": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 },
          "risk": { "enum": ["low", "medium"] },
          "opt_in": { "type": "boolean" },
          "evidence": { "$ref": "#/definitions/evidence" }
        }
      }
    }
  }
}
